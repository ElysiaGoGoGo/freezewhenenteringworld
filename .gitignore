# ============================================================
# FreezeWhenEnteringWorld - NeoForge mod (Minecraft 1.21.1)
# Git ignore rules. Generated/build/dev-only files are ignored;
# sources, resources, docs and gradle wrapper are tracked.
# ============================================================

### Gradle ###
.gradle/
build/
docs/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/**/out/
### Eclipse / Compiler / Language Server ###
.apt_generated
.classpath
.eclipse/
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/
!**/src/**/bin/

### VS Code / Cursor ###
.vscode/

### NetBeans ###
nbproject/

### Gradle run / Minecraft dev workspace ###
.run/
run/
!**/src/**/run/
repo/
!**/src/**/repo/
**/src/generated/**/.cache/

### Minecraft / NeoForge runtime output ###
logs/
crash-reports/
*.log

